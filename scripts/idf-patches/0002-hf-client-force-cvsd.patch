diff --git a/components/bt/host/bluedroid/bta/hf_client/bta_hf_client_main.c b/components/bt/host/bluedroid/bta/hf_client/bta_hf_client_main.c
index 4124a10f..e50cb876 100644
--- a/components/bt/host/bluedroid/bta/hf_client/bta_hf_client_main.c
+++ b/components/bt/host/bluedroid/bta/hf_client/bta_hf_client_main.c
@@ -412,11 +412,22 @@ static void bta_hf_client_api_enable(tBTA_HF_CLIENT_DATA *p_data)
     bta_hf_client_cb.p_cback = p_data->api_enable.p_cback;
 
     /* check if mSBC support enabled */
+#ifdef VB_HF_FORCE_CVSD
+    /* IDF 5.3 derives this from bta_hf_client_version, which is a hardcoded const
+     * (HFP_HF_VERSION_1_7), so CONFIG_BT_HFP_WBS_ENABLE=n does NOT clear it: the AT
+     * layer keeps accepting mSBC and send_at_bac() still advertises AT+BAC=1,2 while
+     * the BTM WBS code is compiled out. Force CVSD so negotiation and code agree. */
+    bta_hf_client_cb.msbc_enabled = FALSE;
+    APPL_TRACE_WARNING("HF codec: msbc_enabled=FALSE (VB_HF_FORCE_CVSD) - mSBC refused, BAC=1 only");
+#else
     if (bta_hf_client_version >= HFP_HF_VERSION_1_6) {
         bta_hf_client_cb.msbc_enabled = TRUE;
     } else{
         bta_hf_client_cb.msbc_enabled = FALSE;
     }
+    APPL_TRACE_WARNING("HF codec: msbc_enabled=%s (framework value, from HFP version)",
+                       bta_hf_client_cb.msbc_enabled ? "TRUE" : "FALSE");
+#endif
 
     bta_hf_client_cb.scb.negotiated_codec = BTM_SCO_CODEC_CVSD;
 
